# Copiar a .env y completar. Nunca commitear .env con valores reales.
# No se lee ninguna variable sin prefijo SUTECBA_ como fallback (SUPABASE_URL,
# DATABASE_URL, etc. del CRM de referencia quedan afuera a propósito).

# local | test | staging | production
SUTECBA_ENV=local

# Conexión utilizada por la aplicación (npm run dev / start) y por create-admin.
# Si se define, se usa Postgres real (pg) en vez de PGlite embebido.
# En producción debe corresponder al rol limitado `sutecba_app`.
# SUTECBA_DATABASE_URL=

# Conexión administrativa utilizada exclusivamente por migrate/seed (rol postgres).
# Nunca usar esta credencial como conexión normal de la app.
# SUTECBA_MIGRATION_DATABASE_URL=

# Archivo de entorno alternativo (opcional). Útil para correr scripts sin leer el `.env` real.
# SUTECBA_ENV_FILE=

# Directorio de datos de PGlite (opcional; por defecto .data/pglite-local
# o .data/pglite-test según SUTECBA_ENV).
# SUTECBA_PGLITE_DATA_DIR=

SUTECBA_TZ=America/Argentina/Buenos_Aires

# Secretos: generar con `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
# SUTECBA_SESSION_SECRET=
# SUTECBA_TOKEN_SECRET=
# SUTECBA_QR_SECRET=
# En producción el secreto de QR es OBLIGATORIO (≥32 caracteres): sin él el sitio responde 500 en todas las rutas (el proceso queda en pie). Una instalación que no usa
# acreditación por QR lo declara explícitamente:
# SUTECBA_QR_DISABLED=true

# Proxies propios delante de la app (para la IP del cliente en los límites públicos). 1 = un nginx (default); 0 = sin proxy.
# SUTECBA_TRUSTED_PROXY_HOPS=1

# SUTECBA_PUBLIC_BASE_URL=
